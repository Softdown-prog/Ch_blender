--- /dev/null
+++ b/build_files/build_environment/patches/ch_legacy_apply_patch.cmake
@@ -0,0 +1,13 @@
+# Idempotent application of a recorded dependency patch.
+find_program(CH_PATCH_EXECUTABLE patch PATHS "C:/Program Files/Git/usr/bin" REQUIRED)
+execute_process(COMMAND "${CH_PATCH_EXECUTABLE}" --dry-run -R -p1 -d "${SOURCE}" -i "${PATCH_PATH}" RESULT_VARIABLE reversed OUTPUT_QUIET ERROR_QUIET)
+if(NOT reversed EQUAL 0)
+  execute_process(COMMAND "${CH_PATCH_EXECUTABLE}" --dry-run -N -p1 -d "${SOURCE}" -i "${PATCH_PATH}" RESULT_VARIABLE checked)
+  if(NOT checked EQUAL 0)
+    message(FATAL_ERROR "Dependency patch does not match ${SOURCE}")
+  endif()
+  execute_process(COMMAND "${CH_PATCH_EXECUTABLE}" -N -p1 -d "${SOURCE}" -i "${PATCH_PATH}" RESULT_VARIABLE applied)
+  if(NOT applied EQUAL 0)
+    message(FATAL_ERROR "Dependency patch failed ${PATCH_PATH}")
+  endif()
+endif()
