--- /dev/null
+++ b/build_files/build_environment/patches/ch_legacy_python_prepare.cmake
@@ -0,0 +1,33 @@
+# Idempotent dependency preparation; never deletes an existing checkout.
+file(MAKE_DIRECTORY "${SOURCE}/externals")
+foreach(dep zlib openssl)
+  if(dep STREQUAL "zlib")
+    set(link "${SOURCE}/externals/zlib-1.2.13")
+    set(target "${ZLIB_SOURCE}")
+  else()
+    set(link "${SOURCE}/externals/openssl-3.0.11")
+    set(target "${SSL_SOURCE}")
+  endif()
+  if(NOT EXISTS "${link}")
+    file(TO_NATIVE_PATH "${link}" native_link)
+    file(TO_NATIVE_PATH "${target}" native_target)
+    execute_process(COMMAND cmd /c mklink /J "${native_link}" "${native_target}" RESULT_VARIABLE result)
+    if(NOT result EQUAL 0)
+      message(FATAL_ERROR "Cannot create dependency junction ${link}")
+    endif()
+  endif()
+endforeach()
+file(COPY "${ZLIB_BUILD}/zconf.h" DESTINATION "${SOURCE}/externals/zlib-1.2.13")
+foreach(patch python_windows_x64.diff ch_legacy_python.diff)
+  execute_process(COMMAND git -C "${SOURCE}" apply --reverse --check "${PATCH_DIR}/${patch}" RESULT_VARIABLE reversed OUTPUT_QUIET ERROR_QUIET)
+  if(NOT reversed EQUAL 0)
+    execute_process(COMMAND git -C "${SOURCE}" apply --check "${PATCH_DIR}/${patch}" RESULT_VARIABLE checked)
+    if(NOT checked EQUAL 0)
+      message(FATAL_ERROR "Cannot apply dependency patch ${patch}")
+    endif()
+    execute_process(COMMAND git -C "${SOURCE}" apply "${PATCH_DIR}/${patch}" RESULT_VARIABLE applied)
+    if(NOT applied EQUAL 0)
+      message(FATAL_ERROR "Dependency patch failed ${patch}")
+    endif()
+  endif()
+endforeach()
